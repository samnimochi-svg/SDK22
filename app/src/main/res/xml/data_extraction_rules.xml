<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive local ADB keypair from automatic cloud backup -->
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="adb_key.pk8" />
        <exclude domain="file" path="adb_cert.der" />
    </device-transfer>
</data-extraction-rules>
