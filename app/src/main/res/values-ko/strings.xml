    <!-- Security Check Engine Strings -->
    <string name="sec_target_sdk_legacy_title">구형 targetSdkVersion: %1$d</string>
    <string name="sec_target_sdk_legacy_desc">Android 9 이전용으로 빌드되었습니다. 최신 개인정보 보호 기능 및 백그라운드 제한이 적용되지 않을 수 있습니다.</string>
    <string name="sec_target_sdk_modern_title">최신 targetSdkVersion %1$d</string>
    <string name="sec_target_sdk_modern_desc">최신 Android 보안 표준(API %1$d)을 준수하여 빌드되었습니다.</string>
    <string name="sec_sig_missing_title">디지털 서명 누락 / 손상</string>
    <string name="sec_sig_missing_desc">APK에서 유효한 디지털 서명을 찾을 수 없습니다. 변조 또는 손상 위험이 높습니다.</string>
    <string name="sec_debug_key_title">디버그 테스트 인증서로 서명됨</string>
    <string name="sec_debug_key_desc">공식 릴리즈 키 대신 Android 개발용 디버그 키(androiddebugkey)로 서명되었습니다. 비공식 또는 수정된 빌드일 수 있습니다.</string>
    <string name="sec_expired_cert_title">서명 인증서 만료됨</string>
    <string name="sec_expired_cert_desc">서명 인증서가 만료되었습니다. 오래된 앱에서는 흔하지만 진위 보증 수준이 낮아집니다.</string>
    <string name="sec_valid_sig_title">검증된 디지털 서명</string>
    <string name="sec_valid_sig_desc">유효한 릴리즈 인증서로 서명되었습니다. SHA-256 지문이 확인되었습니다.</string>
    <string name="sec_split_unsigned_title">분할 APK 서명 누락</string>
    <string name="sec_split_unsigned_desc">아카이브에 서명되지 않은 분할 APK가 포함되어 있습니다. 패키지 무결성이 손상되었습니다.</string>
    <string name="sec_split_mismatch_title">분할 APK 간 서명 불일치 (변조 감지)</string>
    <string name="sec_split_mismatch_desc">base.apk와 분할 APK의 서명 인증서가 다릅니다. 구성 요소가 교체되거나 변조되었을 가능성이 있습니다.</string>
    <string name="sec_split_valid_title">모든 %1$d개 분할 APK 서명 무결성 확인됨</string>
    <string name="sec_split_valid_desc">모든 분할 APK가 base.apk와 동일한 인증서로 올바르게 서명되었음을 확인했습니다.</string>
    <string name="sec_sms_net_title">고위험 조합: SMS 접근 + 인터넷 권한</string>
    <string name="sec_sms_net_desc">2단계 인증 일회용 비밀번호나 SMS 내용을 가로채 외부 서버로 전송할 수 있는 위험한 권한 조합입니다.</string>
    <string name="sec_acc_overlay_title">매우 높은 위험: 접근성 서비스 + 화면 오버레이</string>
    <string name="sec_acc_overlay_desc">UI 자동 조작 및 감시, 피싱 오버레이 화면을 표시할 수 있는 전형적인 악성 소프트웨어 패턴입니다.</string>
    <string name="sec_target22_sensitive_title">자동 일괄 부여 위험: 구형 SDK 민감 권한 요구</string>
    <string name="sec_target22_sensitive_desc">targetSdkVersion이 22 이하이므로 SMS, 위치, 연락처 등 민감한 권한이 설치 시 사용자 동의 없이 자동 일괄 부여됩니다.</string>
    <string name="sec_contacts_net_title">개인정보 주의: 연락처 접근 + 인터넷 권한</string>
    <string name="sec_contacts_net_desc">주소록/연락처 데이터를 외부 서버로 전송할 수 있는 구성입니다.</string>
    <string name="sec_mic_cam_net_title">음성/카메라 + 인터넷 권한</string>
    <string name="sec_mic_cam_net_desc">마이크 녹음이나 카메라 촬영 후 데이터를 외부로 전송할 수 있는 구성입니다.</string>
    <string name="sec_manage_storage_title">모든 파일 접근 권한 (MANAGE_EXTERNAL_STORAGE)</string>
    <string name="sec_manage_storage_desc">기기 내 모든 사진, 문서 및 파일에 대한 광범위한 접근 권한을 요청합니다.</string>
    <string name="sec_install_packages_title">앱 설치 요청 권한</string>
    <string name="sec_install_packages_desc">이 앱이 다른 APK 패키지의 설치를 요청할 수 있도록 허용합니다.</string>
    <string name="sec_phone_state_title">전화 상태 읽기 권한 (READ_PHONE_STATE)</string>
    <string name="sec_phone_state_desc">전화번호, SIM 정보, 통화 상태 등 기기 식별 정보에 대한 접근을 요청합니다.</string>
    <string name="sec_no_permissions_title">요청된 권한 없음</string>
    <string name="sec_no_permissions_desc">이 앱은 특별한 시스템 권한을 요청하지 않습니다.</string>
    <string name="sec_summary_safe">주목할 만한 보안 문제는 발견되지 않았습니다.</string>
    <string name="sec_summary_warning">주의가 필요한 권한 또는 사양이 포함되어 있습니다. 세부 정보를 검토하세요.</string>
    <string name="sec_summary_dangerous">위험 가능성이 높은 서명 또는 권한 조합이 감지되었습니다.</string>

